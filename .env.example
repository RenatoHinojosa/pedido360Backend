# --- Credenciales de AWS Academy Learner Lab ---
# Se obtienen desde el botón "AWS Details" del Lab (Show / Download).
# IMPORTANTE: expiran junto con la sesión del lab (~unas horas), hay que
# refrescarlas en este archivo (y en GitHub Secrets) cada vez que caduquen.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# ARN del rol que entrega el laboratorio. No se puede crear un rol propio
# en una cuenta Academy, por eso Serverless reutiliza este.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole

# --- Microsoft Entra ID (backend App Registration) ---
# Solo el Client ID, SIN el prefijo "api://" ni una URL completa.
AZURE_API_AUDIENCE=
AZURE_TENANT_ID=
